---
// Header theme switcher. Replaces Starlight's native <select> with a custom
// listbox in the site's style. Behaviour lives in scripts/theme-select.js and
// the shared preference in scripts/theme.js.
import { Icon } from '@astrojs/starlight/components';

const options = [
  { value: 'dark', label: 'Dark', icon: 'moon' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'auto', label: 'Auto', icon: 'laptop' },
] as const;
---

<fonn-theme-select class="theme-select">
  <button type="button" class="theme-select-button" aria-haspopup="listbox" aria-expanded="false" aria-label="Theme: Auto">
    {options.map((option) => (
      <span class="theme-select-current" data-value={option.value} hidden={option.value !== 'auto'}>
        <Icon name={option.icon} size="1rem" />
        <span>{option.label}</span>
      </span>
    ))}
    <svg class="theme-select-chevron" aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
      <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul class="theme-select-menu" role="listbox" aria-label="Theme" tabindex="-1" hidden>
    {options.map((option) => (
      <li role="option" data-value={option.value} aria-selected={option.value === 'auto' ? 'true' : 'false'}>
        <Icon name={option.icon} size="1rem" />
        <span>{option.label}</span>
        <svg class="theme-select-check" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
          <path d="M3 8.5 6.4 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </li>
    ))}
  </ul>
</fonn-theme-select>

<script>
  import '../scripts/theme-select.js';
</script>
