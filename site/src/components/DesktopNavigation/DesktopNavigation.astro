---
const path = Astro.url.pathname;
const links = [
  { label: 'Home', href: '/', current: path === '/' },
  { label: 'Docs', href: '/start/overview/', current: path !== '/' && path !== '/start/install/' && path !== '/how-it-works/' && path !== '/404/' },
  { label: 'Install', href: '/start/install/', current: path === '/start/install/' },
  { label: 'Visualiser', href: '/how-it-works/', current: path === '/how-it-works/' },
];
---

<nav class="desktop-navigation" aria-label="Primary">
  {links.map(({ label, href, current }) => (
    <a href={href} aria-current={current ? (path === href ? 'page' : 'true') : undefined}>{label}</a>
  ))}
</nav>

<style>
  .desktop-navigation { display: none; }

  @media (min-width: 72rem) {
    .desktop-navigation {
      display: flex;
      gap: 0.375rem;
      border-top: 1px solid var(--border);
      padding-top: 0.375rem;
    }
    a {
      display: inline-flex;
      align-items: center;
      min-height: 2.25rem;
      padding: 0.25rem 1rem;
      border-radius: 0.5rem;
      color: var(--muted);
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
    }
    a:hover { color: var(--text); background: var(--bg-2); }
    a[aria-current] { background: var(--accent-soft); color: var(--accent-strong); }
    a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  }
</style>
