---
// Before and after for one sample, produced at build time by the real
// compiled filter. Character counts describe this sample only; they are not
// token, cost or accuracy measurements.
import { createOutputFilter } from '../../../packages/core/dist/filtering/index.js';
import { samples } from '../scripts/visualiser/samples.js';

interface Props {
  sample: string;
  level?: 'strict' | 'standard' | 'similar';
  /** Show the original and the result, or only the original when nothing changes. */
  compare?: boolean;
}

const { sample: id, level = 'standard', compare = true } = Astro.props;
const sample = samples.find((item) => item.id === id);
if (!sample) throw new Error(`FilterDemo: unknown sample "${id}".`);

const filter = createOutputFilter({
  mode: 'filter',
  level,
  store: { save: async () => ({ id: '3f6c1d2e-8a4b-4c1d-9e2f-5a6b7c8d9e0f' }) },
  recoveryHint: (artifactId) => `Recover the original tool response with: fonn native-output <launch-id> ${artifactId}`,
});
const { response, decision } = await filter.apply({
  toolName: 'Bash',
  toolInput: { command: sample.command },
  response: { stdout: sample.stdout, stderr: '' },
  sessionId: 'docs',
  toolUseId: 'docs',
});

const format = (value: number) => value.toLocaleString('en-US');
const filtered = decision.status === 'filtered';
const share = Math.round((1 - decision.deliveredCharacters / decision.originalCharacters) * 100);
const stats = filtered
  ? `${format(decision.originalCharacters)} characters in, ${format(decision.deliveredCharacters)} delivered, ${format(decision.removedLines)} lines removed. That is ${share}% fewer characters for this sample only.`
  : `${format(decision.originalCharacters)} characters in, the same delivered. Nothing changes at the ${level} level.`;
---

<div class="filter-demo not-content">
  <p class="demo-command"><span>$</span> {sample.command}{level !== 'standard' && <span class="demo-level">--filter-level {level}</span>}</p>
  {compare && filtered ? (
    <>
      {/* On phones the original starts collapsed: its 80-column rows wrap badly there. */}
      <details class="demo-original" open>
        <summary>Original observation <span>{format(decision.originalCharacters)} chars</span></summary>
        <pre class="output demo-output" tabindex="0"><code>{sample.stdout.trimEnd()}</code></pre>
      </details>
      <p class="demo-label">What the model receives</p>
      <pre class="output demo-output" tabindex="0"><code>{response.stdout.trimEnd()}</code></pre>
    </>
  ) : (
    <>
      <p class="demo-label">Original observation</p>
      <pre class="output demo-output" tabindex="0"><code>{sample.stdout.trimEnd()}</code></pre>
    </>
  )}
  <p class="demo-stats">{stats}</p>
</div>

<script>
  // Collapse the originals on phones. Without JavaScript they stay open.
  if (window.matchMedia('(max-width: 40rem)').matches) {
    for (const details of document.querySelectorAll('.demo-original')) details.open = false;
  }
</script>

<style>
  .filter-demo {
    display: grid;
    gap: 6px;
  }

  .demo-command {
    margin: 0 0 4px;
    font: 0.85rem var(--mono);
    color: var(--muted);
  }

  .demo-command span:first-child {
    color: var(--accent);
    margin-right: 6px;
  }

  .demo-level {
    margin-left: 8px;
    color: var(--accent);
  }

  .demo-original summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 8px 0 6px;
    cursor: pointer;
    font: 600 0.75rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* display: flex hides the browser's marker, so draw a chevron instead. */
  .demo-original summary::before {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    align-self: center;
  }

  .demo-original[open] summary::before {
    transform: rotate(45deg);
  }

  .demo-original summary span {
    letter-spacing: 0;
    text-transform: none;
    font-weight: 400;
  }

  .demo-original:not([open]) summary {
    padding: 10px 12px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .demo-label {
    margin: 8px 0 0;
    font: 600 0.75rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Long lines wrap rather than scroll, so the demo reads at any width. */
  .demo-output {
    max-height: 300px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    overflow-x: hidden;
  }

  /* Slightly smaller on phones, so typical 45-character log lines fit. */
  @media (max-width: 40rem) {
    .demo-output {
      font-size: 0.7rem;
      padding: 10px;
    }
  }

  .demo-stats {
    margin: 6px 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
