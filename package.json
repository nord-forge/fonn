{
  "name": "fonn",
  "version": "0.1.0",
  "private": true,
  "description": "Core, CLI, Homebrew distribution and future desktop app for Fonn.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fonn": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx packages/cli/src/cli/main.ts",
    "build": "node scripts/build.mjs",
    "docs:build": "npm run build --workspace @nord-forge/fonn-core && npm --prefix site run build",
    "docs:dev": "npm run build --workspace @nord-forge/fonn-core && npm --prefix site run dev",
    "docs:deploy": "node scripts/docs-deploy.mjs",
    "typecheck": "npm run build --workspace @nord-forge/fonn-core && npm run typecheck --workspaces --if-present && tsc --noEmit",
    "test": "npm run test --workspaces --if-present && node --test tests/packaging/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "check:mac": "node scripts/check-local.mjs",
    "release:prepare": "npm run build && node scripts/release/prepare.mjs",
    "release:check": "node --test tests/packaging/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/fonn.git"
  },
  "homepage": "https://github.com/nord-forge/fonn#readme",
  "bugs": {
    "url": "https://github.com/nord-forge/fonn/issues"
  }
}
