{
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nord-forge/fonn#readme",
  "bugs": {
    "url": "https://github.com/nord-forge/fonn/issues"
  },
  "name": "@nord-forge/fonn-cli",
  "description": "Local Fonn CLI with native Claude and Codex launchers.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fonn": "./dist/cli/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/fonn.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "node ../../scripts/build-ui-assets.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node ../../scripts/build-ui-assets.mjs && tsc --noEmit",
    "test": "node ../../scripts/build-ui-assets.mjs && tsx --test tests/**/*.test.ts tests/**/*.test.mjs"
  },
  "dependencies": {
    "@nord-forge/fonn-core": "0.2.0",
    "zod": "4.6.7"
  }
}
