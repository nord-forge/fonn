{
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nord-forge/fonn#readme",
  "bugs": {
    "url": "https://github.com/nord-forge/fonn/issues"
  },
  "name": "@nord-forge/fonn-core",
  "description": "Profiles, conservative tool-output filtering, task state and Claude Agent SDK execution.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "import": "./dist/profiles.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./filtering": {
      "types": "./dist/filtering/index.d.ts",
      "import": "./dist/filtering/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./state": {
      "types": "./dist/runtime/storage.d.ts",
      "import": "./dist/runtime/storage.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/fonn.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "zod": "4.6.7"
  }
}
